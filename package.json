{
  "name": "embargo-room",
  "version": "1.0.0",
  "description": "A Switch room that runs a software vulnerability disclosure from report to public advisory: agents keep the embargo clock, verify patches against the vendor's real commits, coordinate downstreams and draft the advisory; humans hold sign-off and go-to-publish.",
  "license": "MIT",
  "author": "CodingwithKetan",
  "type": "commonjs",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "test": "bash scripts/selfcheck.sh",
    "verify": "./verify.sh --target vulnerable && ./verify.sh --target bad-patch && ./verify.sh --target patched",
    "verify:local": "./verify-local.sh --target vulnerable; ./verify-local.sh --target bad-patch; ./verify-local.sh --target patched",
    "cases": "node cases/run.js cases/minimist-cve-2021-44906.json cases/minimist-cve-2020-7598.json",
    "osv": "node osv/osv-lookup.js minimist",
    "watch": "node watch/watch.js",
    "readiness": "node downstream/readiness.js downstream/state.example.json",
    "record:verify": "node record/export-record.js verify record/embargo-minimist-demo.record.json",
    "emit": "node publish/emit-advisory.js record/embargo-minimist-demo.record.json --state downstream/state.example.json",
    "emit:validate": "node publish/emit-advisory.js --validate record/embargo-minimist-demo.record.json",
    "assure": "node assure/verify-work.js --against record/embargo-minimist-demo.record.json",
    "redteam": "bash security/redteam/redteam.sh",
    "bridge": "node bridge/status.js",
    "clock:demo": "node clock/clock.js init --scale 30 && node clock/clock.js notify && node clock/clock.js status"
  }
}
